    "dev:server": "npm --prefix server run dev",
    "test:server": "npm --prefix server test"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.4.0",
    "@fortawesome/free-brands-svg-icons": "^6.4.0",
