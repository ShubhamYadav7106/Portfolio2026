{
  "name": "webdev_portfolio",
  "homepage": ".",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "npm run validate:knowledge && vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs && npm run test:server",
