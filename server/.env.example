# Server-only credentials. Fill the real key in server/.env, never in Vue/VITE_*.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
PORT=3001
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
REQUEST_TIMEOUT_MS=60000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
MAX_CONCURRENT_REQUESTS=4
MAX_COMPLETION_TOKENS=2048
GROQ_RECRUITER_API_KEY=
GROQ_GENERAL_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Recruiter-only fallback. Set the Gemini key and a supported model to enable it.
GROQ_RECRUITER_TPM_THRESHOLD_PERCENT=85
GROQ_RECRUITER_QUOTA_MAX_AGE_MS=15000
GROQ_RECRUITER_QUOTA_PROBE_MS=60000
GEMINI_RECRUITER_API_KEY=
GEMINI_RECRUITER_MODEL=
